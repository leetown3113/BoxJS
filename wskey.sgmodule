#!name=京东 Wskey
#!desc=自动获取京东 Wskey
#!category=JD
#!system=ios

[Script]
京东 WSKEY = type=http-request,pattern=^https:\/\/(?:sh\.jd\.com\/d\?fl=),requires-body=0,max-size=0,binary-body-mode=0,timeout=30,script-path=https://raw.githubusercontent.com/leetown3113/BoxJS/main/Script/wskey.js,script-update-interval=0

[MITM]
hostname = %APPEND% sh.jd.com
