#!name=京东 Cookie
#!desc=自动获取京东 Cookie (pt_key;pt_pin)
#!category=JD
#!system=ios

[Script]
京东 Cookie = type=http-request,pattern=^https:\/\/mars\.jd\.com\/log\/sdk\/v2,requires-body=0,max-size=0,binary-body-mode=0,timeout=30,script-path=https://raw.githubusercontent.com/leetown3113/BoxJS/main/Script/jdcookie.js,script-update-interval=0

[MITM]
hostname = %APPEND% mars.jd.com
