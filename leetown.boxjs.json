{
  "id": "leetown.app.sub",
  "name": "leetown自用订阅",
  "author": "@leetown",
  "icon": "https://avatars.githubusercontent.com/u/140289459?s=400&u=6ef54a783bcc2f624efabe60d851f390689bdde8&v=4",
  "repo": "https://github.com/leetown3113/BoxJS",
  "apps": [
	      {
      "id": "leetown_jdcookie_ql",
      "name": "京东 Cookie 青龙同步",
      "keys": [
        "auto_sync_jdcookie_ql",
        "jdCookieList",
        "ql_url",
        "ql_client_id",
        "ql_client_secret",
        "ql_token",
        "ql_token_expires"
      ],
      "descs_html": [
        "<h4 align=\"center\">京东 Cookie 同步到青龙面板</h4>",
        "<p style=\"text-align: center;\">💡 支持获取新 Cookie 时自动同步（需配置青龙信息并开启自动同步），也可点击下方按钮手动触发同步</p>"
      ],
      "settings": [
        {
          "id": "auto_sync_jdcookie_ql",
          "name": "获取后自动同步到青龙",
          "val": true,
          "type": "boolean",
          "desc": "开启后，每次抓取到新 Cookie 时自动同步到青龙面板（默认开启）"
        },
        {
          "id": "ql_url",
          "name": "青龙面板地址",
          "val": "",
          "type": "text",
          "placeholder": "http://192.168.1.100:5700",
          "desc": "青龙面板的完整地址，如 http://192.168.1.100:5700"
        },
        {
          "id": "ql_client_id",
          "name": "青龙 Client ID",
          "val": "",
          "type": "text",
          "placeholder": "请输入 Client ID",
          "desc": "在青龙面板系统设置-应用设置中创建应用后获取"
        },
        {
          "id": "ql_client_secret",
          "name": "青龙 Client Secret",
          "val": "",
          "type": "text",
          "placeholder": "请输入 Client Secret",
          "desc": "在青龙面板系统设置-应用设置中创建应用后获取"
        },
        {
          "id": "jdCookieList",
          "name": "Cookie 列表",
          "val": "",
          "type": "textarea",
          "autoGrow": true,
          "rows": 5,
          "desc": "存储的京东 Cookie 列表，JSON 格式"
        }
      ],
      "scripts": [
        {
          "name": "同步 Cookie 到青龙",
          "script": "https://raw.githubusercontent.com/leetown3113/BoxJS/main/Script/jdcookie_ql_sync.js"
        },
        {
          "name": "清空 Cookie 列表",
          "script": "https://raw.githubusercontent.com/leetown3113/BoxJS/main/Script/jdcookie_clear.js"
        }
      ],
      "author": "@leetown",
      "icons": [
        "https://raw.githubusercontent.com/Orz-3/task/master/jd.png",
        "https://raw.githubusercontent.com/Orz-3/task/master/jd.png"
      ]
    },
    {
      "id": "leetown_wskey_ql",
      "name": "京东 WSKEY 青龙同步",
      "keys": [
        "wskeyList",
        "ql_url",
        "ql_client_id",
        "ql_client_secret",
        "ql_token",
        "ql_token_expires"
      ],
      "descs_html": [
        "<h4 align=\"center\">手动将 BoxJS 中的京东 WSKEY 同步到青龙面板</h4>",
        "<p style=\"text-align: center;\">⚠️ 注意:此功能为手动同步,需在获取 WSKEY 后点击下方按钮触发同步</p>"
      ],
      "settings": [
        {
          "id": "ql_url",
          "name": "青龙面板地址",
          "val": "",
          "type": "text",
          "placeholder": "http://192.168.1.100:5700",
          "desc": "青龙面板的完整地址，如 http://192.168.1.100:5700"
        },
        {
          "id": "ql_client_id",
          "name": "青龙 Client ID",
          "val": "",
          "type": "text",
          "placeholder": "请输入 Client ID",
          "desc": "在青龙面板系统设置-应用设置中创建应用后获取"
        },
        {
          "id": "ql_client_secret",
          "name": "青龙 Client Secret",
          "val": "",
          "type": "text",
          "placeholder": "请输入 Client Secret",
          "desc": "在青龙面板系统设置-应用设置中创建应用后获取"
        },
        {
          "id": "wskeyList",
          "name": "WSKEY 列表",
          "val": "",
          "type": "textarea",
          "autoGrow": true,
          "rows": 5,
          "desc": "存储的 WSKEY 列表，JSON 格式"
        }
      ],
      "scripts": [
        {
          "name": "同步 WSKEY 到青龙",
          "script": "https://raw.githubusercontent.com/leetown3113/BoxJS/main/Script/wskey_ql_sync.js"
        },
        {
          "name": "清空 WSKEY 列表",
          "script": "https://raw.githubusercontent.com/leetown3113/BoxJS/main/Script/wskey_clear.js"
        }
      ],
      "author": "@leetown",
      "icons": [
        "https://raw.githubusercontent.com/Orz-3/task/master/jd.png",
        "https://raw.githubusercontent.com/Orz-3/task/master/jd.png"
      ]
    },
    {
      "id": "JD_Cookies",
      "name": "京东账号",
      "keys": ["jdCookieList", "CookiesJD", "cks_get_mute"],
      "settings": [
        {
          "id": "cks_get_mute",
          "name": "静音获取",
          "val": false,
          "type": "boolean"
        },
        {
          "id": "jdCookieList",
          "name": "CK 列表 (JSON 格式)",
          "val": "",
          "type": "textarea",
          "autoGrow": true,
          "rows": 15,
          "primary": ["userName"],
          "child": []
        }
      ],
      "icons": [
        "https://raw.githubusercontent.com/Orz-3/mini/master/jd.png",
        "https://raw.githubusercontent.com/Orz-3/task/master/jd.png"
      ],
      "author": "@leetown"
    },
    {
      "id": "JD_Cookies_remark",
      "name": "登录助手",
      "keys": ["CookieIndex", "@jd_ck_remark.remark", "@jd_ck_remark.mute"],
      "settings": [
        {
          "id": "@jd_ck_remark.mute",
          "name": "通知静音",
          "val": false,
          "type": "boolean"
        },
        {
          "id": "CookieIndex",
          "name": "默认账号",
          "val": 0,
          "type": "text",
          "autoGrow": false,
          "rows": 2,
          "placeholder": "cookie 下标（0）"
        },

        {
          "id": "@jd_ck_remark.remark",
          "name": "CK 备注列表 (JSON 格式)",
          "val": "",
          "type": "textarea",
          "autoGrow": true,
          "rows": 3,
          "primary": ["nickname", "status"],
          "child": [
            {
              "id": "index",
              "name": "下标",
              "type": "text",
              "disabled": true
            },
            {
              "id": "username",
              "name": "用户 pin",
              "disabled": true,
              "type": "text"
            },
            {
              "id": "mobile",
              "name": "手机号",
              "type": "text"
            },
            {
              "id": "remark",
              "name": "备注",
              "type": "text"
            },
            {
              "id": "isPlusVip",
              "name": "是否是 VIP",
              "disabled": true,
              "type": "text"
            },
            {
              "id": "beanNum",
              "name": "京豆数量",
              "disabled": true,
              "type": "text"
            }
          ]
        }
      ],
      "icons": [
        "https://raw.githubusercontent.com/Orz-3/mini/master/jd.png",
        "https://raw.githubusercontent.com/Orz-3/task/master/jd.png"
      ],
	  "author": "@leetown",
      "script": "https://raw.githubusercontent.com/leetown3113/BoxJS/main/JD/jd_cookie_search.js"
    },

    {
      "id": "ql",
      "name": "青龙同步",
      "keys": [
        "@ql.ip",
        "@ql.client_id",
        "@ql.client_secret",
        "@ql.username",
        "@ql.password",
        "@ql.env",
        "@ql.ENV_KEY",
        "@ql.mute",
        "@ql.is_pwd"
      ],
      "settings": [
        {
          "id": "@ql.mute",
          "name": "静音",
          "val": false,
          "type": "boolean",
          "desc": "同步时，不会执行通知提示"
        },
        {
          "id": "@ql.is_pwd",
          "name": "开启密码登陆",
          "val": false,
          "type": "boolean",
          "desc": "同步时，优先使用密码登陆"
        },
        {
          "id": "@ql.ENV_KEY",
          "name": "环境变量KEY",
          "val": "",
          "type": "textarea",
          "autoGrow": false,
          "placeholder": "boxjs 同步到 Ql 的环境变量",
          "primary": ["BoxJsKey"],
          "childScripts": [
            {
              "name": "同步到青龙",
              "script": "https://raw.githubusercontent.com/leetown3113/BoxJS/main/JD/boxjs_env_to_ql.js"
            }
          ],
          "child": [
            {
              "id": "BoxJsKey",
              "name": "BoxJS缓存Key",
              "type": "cacheKey",
              "desc": "读取BoxJS对应Key的值"
            },
            {
              "id": "qlKey",
              "name": "青龙环境变量KEY",
              "type": "text"
            },
            {
              "id": "remark",
              "name": "覆盖备注",
              "type": "textarea",
              "placeholder": "请输入覆盖备注",
              "desc": "覆盖和青龙环境变量中备注相同的变量"
            }
          ]
        },
        {
          "id": "@ql.ip",
          "name": "青龙登陆的域名或IP:端口号",
          "val": "",
          "type": "text",
          "placeholder": "111.21.0.32:5700"
        },
        {
          "id": "@ql.client_id",
          "name": "应用 Client ID",
          "val": "",
          "type": "text"
        },
        {
          "id": "@ql.client_secret",
          "name": "应用 Client Secret",
          "val": "",
          "type": "text"
        },
        {
          "id": "@ql.username",
          "name": "账号",
          "val": "",
          "type": "text"
        },
        {
          "id": "@ql.password",
          "name": "密码",
          "val": "",
          "type": "text"
        }
      ],
      "icons": [
        "https://raw.githubusercontent.com/dompling/Script/master/image/ql.png",
        "https://raw.githubusercontent.com/dompling/Script/master/image/ql.png"
      ],
      "author": "@leetown",
      "repo": "https://raw.githubusercontent.com/leetown3113/BoxJS/main/JD/ql_cookie_sync.js",
      "scripts": [
        {
		  "name": "BoxJS同步到青龙",
          "script": "https://raw.githubusercontent.com/leetown3113/BoxJS/main/JD/ql_cookie_sync.js"
        },
        {
          "name": "青龙同步到BoxJS",
          "script": "https://raw.githubusercontent.com/leetown3113/BoxJS/main/JD/ql_sync_box.js"
        }
      ]
    },
    		{
			"id": "TestFlight",
			"name": "TF监控",
			"keys": [],
			"settings": [
				{
					"id": "appkey",
					"name": "监控appkey",
					"val": "",
					"type": "textarea",
					"placeholder": "VCIvwk2g,1SyedSId",
					"autoGrow": true,
					"rows": 1,
					"desc": "以英文逗号分隔多个key"
				},
				{
					"id": "testflight_isnotify",
					"name": "是否静默通知",
					"val": "",
					"type": "boolean",
					"placeholder": "true or false",
					"autoGrow": true,
					"rows": 1,
					"desc": "没有tf位置将不会通知"
				}
			],
			"author": "@leetown",
			"icons": [
				"https://raw.githubusercontent.com/Orz-3/mini/master/testflight.png",
				"https://raw.githubusercontent.com/Orz-3/task/master/testflight.png"
			]
		}
  ]
}
