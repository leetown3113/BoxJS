#!name=JD Cookie Push To DaiDaiPanel
#!desc=自动获取京东 Cookie 推送到呆呆面板
#!category=JD
#!system=ios

[Script]
京东 Cookie daidai= type=http-request,pattern=^https:\/\/mars\.jd\.com\/log\/sdk\/v2,requires-body=0,max-size=0,binary-body-mode=0,timeout=30,script-path=https://raw.githubusercontent.com/leetown3113/BoxJS/main/jd_ck_push_daidai.js,script-update-interval=0

[MITM]
hostname = %APPEND% mars.jd.com
